#!/bin/bash
# DSM postinst
set -e

PKG_NAME="${SYNOPKG_PKGNAME:-$(basename "$(cd "$(dirname "$0")/.." && pwd)")}"
PKG_DIR="/var/packages/$PKG_NAME"
TARGET="$PKG_DIR/target"
VAR="$PKG_DIR/var"
ETC="$PKG_DIR/etc"

echo "[postinst] $PKG_NAME"

mkdir -p "$VAR/log" "$VAR/zerotier" "$VAR/rtp2httpd" "$ETC"

chmod +x "$TARGET/bin/"* 2>/dev/null || true

# DSM 6.2.3 tun 设备预处理
if [ ! -e /dev/net/tun ]; then
    mkdir -p /dev/net 2>/dev/null || true
    mknod /dev/net/tun c 10 200 2>/dev/null || true
    chmod 666 /dev/net/tun 2>/dev/null || true
fi

for m in tun sit ip_tunnel gre vxlan; do
    modprobe "$m" 2>/dev/null || true
done

chown -R root:root "$TARGET" 2>/dev/null || true

echo "[postinst] done (data: $VAR)"
exit 0
